{
  "name": "@kinetick-labs/kh-acp",
  "description": "Automation-only Agent Client Protocol server for driving KinetickHarness agents over JSON-RPC stdio",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@kinetick-labs/kh-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-attachment": "workspace:*",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-mcp-client": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-session-persistence": "workspace:*",
    "@kinetick-labs/kh-token-meter": "workspace:*",
    "@kinetick-labs/kh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@kinetick-labs/kh-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-agent-loop": "workspace:*",
    "@kinetick-labs/kh-agent-loop-testkit": "workspace:*",
    "@kinetick-labs/kh-attachment": "workspace:*",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-mcp-client": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-session-persistence": "workspace:*",
    "@kinetick-labs/kh-session-persistence-jsonl": "workspace:*",
    "@kinetick-labs/kh-session-projection": "workspace:*",
    "@kinetick-labs/kh-token-meter": "workspace:*",
    "@kinetick-labs/kh-tools": "workspace:*",
    "@kinetick-labs/kh-user-approval": "workspace:*"
  }
}
