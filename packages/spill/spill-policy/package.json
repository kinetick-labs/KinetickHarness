    "@kinetick-labs/kh-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-attachment": "workspace:*",
    "@kinetick-labs/kh-fs": "workspace:*",
    "@kinetick-labs/kh-token-meter": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
