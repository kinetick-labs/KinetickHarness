{
  "name": "@kinetick-labs/kh-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the KinetickHarness Auto permission preset",
  "version": "0.2.1-alpha.1",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-agent-instructions": "workspace:*",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-permission-presets": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@kinetick-labs/kh-util-values": "workspace:*"
  },
  "devDependencies": {
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-agent-instructions": "workspace:*",
    "@kinetick-labs/kh-agent-loop": "workspace:*",
    "@kinetick-labs/kh-agent-loop-testkit": "workspace:*",
    "@kinetick-labs/kh-bash-sandbox": "workspace:*",
    "@kinetick-labs/kh-compaction": "workspace:*",
    "@kinetick-labs/kh-fs-local": "workspace:*",
    "@kinetick-labs/kh-fs-observation-policy": "workspace:*",
    "@kinetick-labs/kh-fs-sandbox": "workspace:*",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-llm-deepseek": "workspace:*",
    "@kinetick-labs/kh-llm-deepseek-api-key": "workspace:*",
    "@kinetick-labs/kh-permission-presets": "workspace:*",
    "@kinetick-labs/kh-ptc-runtime-node": "workspace:*",
    "@kinetick-labs/kh-sandbox": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-session-projection": "workspace:*",
    "@kinetick-labs/kh-shell": "workspace:*",
    "@kinetick-labs/kh-shell-env": "workspace:*",
    "@kinetick-labs/kh-subagent": "workspace:*",
    "@kinetick-labs/kh-subprocess-local": "workspace:*",
    "@kinetick-labs/kh-system-prompt": "workspace:*",
    "@kinetick-labs/kh-tool-bash": "workspace:*",
    "@kinetick-labs/kh-tool-fs": "workspace:*",
    "@kinetick-labs/kh-tool-subagent": "workspace:*",
    "@kinetick-labs/kh-tools": "workspace:*",
    "@kinetick-labs/kh-user-approval": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  },
  "kh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
