{
  "name": "@kinetick-labs/kh-experimental-webworker-runtime",
  "description": "Browser-only harness runtime: in-memory VFS, module transform and loader, postMessage tunnel, and the dedicated Web Worker assembly, with the Node-compatibility layer that lets the host tree run unchanged",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/experimental/webworker-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": "./lib/worker.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@kinetick-labs/kh-util-crypto": "workspace:*",
    "@noble/hashes": "^2.3.0",
    "@yarnpkg/parsers": "^3.1.0",
    "acorn": "^8.17.0",
    "buffer": "^6.0.3",
    "picomatch": "^4.0.4",
    "readable-stream": "^4.7.0",
    "@kinetick-labs/kh-client-web": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@kinetick-labs/kh-client-connection": "workspace:*",
    "@kinetick-labs/kh-client-modules": "workspace:*",
    "@kinetick-labs/kh-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@kinetick-labs/kh-api-gateway": "workspace:*",
    "@kinetick-labs/kh-app-boot": "workspace:*",
    "@kinetick-labs/kh-bash-sandbox": "workspace:*",
    "@kinetick-labs/kh-client-connection": "workspace:*",
    "@kinetick-labs/kh-client-file-upload": "workspace:*",
    "@kinetick-labs/kh-client-modules": "workspace:*",
    "@kinetick-labs/kh-host-webserver": "workspace:*",
    "@kinetick-labs/kh-sandbox-local": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-session-projection": "workspace:*",
    "@kinetick-labs/kh-session-persistence-jsonl": "workspace:*",
    "@kinetick-labs/kh-subagent": "workspace:*",
    "@kinetick-labs/kh-subprocess-local": "workspace:*",
    "@deepseek-ai/node-addon-system": "workspace:~",
    "@types/picomatch": "^3.0.2",
    "@types/readable-stream": "^4.0.24",
    "chokidar": "^5.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
