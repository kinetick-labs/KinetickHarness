{
  "name": "@kinetick-labs/kh-experimental-ptc-runtime-python",
  "description": "CPython subprocess implementation of the KinetickHarness PTC execution seam",
  "version": "0.2.1-alpha.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/experimental/ptc-runtime-python"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "py/**/*.py",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@kinetick-labs/kh-ptc-runtime": "workspace:*",
    "@kinetick-labs/kh-timeout": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-util-values": "workspace:*"
  },
  "devDependencies": {
    "@kinetick-labs/kh-ptc-runtime": "workspace:*",
    "@kinetick-labs/kh-timeout": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-util-values": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  }
}
