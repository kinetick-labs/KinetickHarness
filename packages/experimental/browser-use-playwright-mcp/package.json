{
  "name": "@kinetick-labs/kh-experimental-browser-use-playwright-mcp",
  "description": "Experimental per-Session Chromium browser tools through @playwright/mcp",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/experimental/browser-use-playwright-mcp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@kinetick-labs/kh-experimental-browser-use-runtime": "workspace:*",
    "@playwright/mcp": "0.0.80"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-browser-use": "workspace:*",
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-tools": "workspace:*",
    "@kinetick-labs/kh-system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@kinetick-labs/kh-browser-use": "workspace:*",
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-agent-loop": "workspace:*",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-tools": "workspace:*",
    "@kinetick-labs/kh-system-prompt": "workspace:*",
    "@kinetick-labs/kh-session-projection": "workspace:*"
  }
}
