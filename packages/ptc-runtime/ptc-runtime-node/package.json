{
  "name": "@kinetick-labs/kh-ptc-runtime-node",
  "description": "Sandboxed Node process implementation of the KinetickHarness PTC execution capability",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-ptc-runtime": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-timeout": "workspace:*",
    "@kinetick-labs/kh-fs": "workspace:*",
    "@kinetick-labs/kh-subprocess": "workspace:*",
    "@kinetick-labs/kh-sandbox": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@kinetick-labs/kh-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-ptc-runtime": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-timeout": "workspace:*",
    "@kinetick-labs/kh-fs": "workspace:*",
    "@kinetick-labs/kh-subprocess": "workspace:*",
    "@kinetick-labs/kh-sandbox": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*",
    "@kinetick-labs/kh-fs-local": "workspace:*",
    "@kinetick-labs/kh-subprocess-local": "workspace:*",
    "@kinetick-labs/kh-session-projection": "workspace:*",
    "@kinetick-labs/kh-sandbox-local": "workspace:*"
  }
}
