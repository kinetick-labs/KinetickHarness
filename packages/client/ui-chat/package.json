{
  "name": "@kinetick-labs/kh-client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "kh": {
    "client": {
      "inject": [
        "@kinetick-labs/kh-api-session-controller",
        "@kinetick-labs/kh-api-workspace-controller",
        "@kinetick-labs/kh-client-locale",
        "@kinetick-labs/kh-client-ui-conversation",
        "@kinetick-labs/kh-client-ui-input-trigger",
        "@kinetick-labs/kh-client-ui-layout",
        "@kinetick-labs/kh-client-ui-renderer",
        "@kinetick-labs/kh-client-ui-session",
        "@kinetick-labs/kh-client-ui-settings",
        "@kinetick-labs/kh-client-ui-sidebar-right",
        "@kinetick-labs/kh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-api-remotes": "workspace:*",
    "@kinetick-labs/kh-api-session-controller": "workspace:*",
    "@kinetick-labs/kh-api-workspace-controller": "workspace:*",
    "@kinetick-labs/kh-api-workspace-files": "workspace:*",
    "@kinetick-labs/kh-attachment": "workspace:*",
    "@kinetick-labs/kh-brand": "workspace:*",
    "@kinetick-labs/kh-client-locale": "workspace:*",
    "@kinetick-labs/kh-client-store": "workspace:*",
    "@kinetick-labs/kh-client-ui-approval": "workspace:*",
    "@kinetick-labs/kh-client-ui-conversation": "workspace:*",
    "@kinetick-labs/kh-client-ui-input-trigger": "workspace:*",
    "@kinetick-labs/kh-client-ui-layout": "workspace:*",
    "@kinetick-labs/kh-client-ui-primitives": "workspace:*",
    "@kinetick-labs/kh-client-ui-renderer": "workspace:*",
    "@kinetick-labs/kh-client-ui-session": "workspace:*",
    "@kinetick-labs/kh-client-ui-settings": "workspace:*",
    "@kinetick-labs/kh-client-ui-sidebar-browser": "workspace:*",
    "@kinetick-labs/kh-client-ui-sidebar-documentpreview": "workspace:*",
    "@kinetick-labs/kh-client-ui-sidebar-right": "workspace:*",
    "@kinetick-labs/kh-client-ui-slots": "workspace:*",
    "@kinetick-labs/kh-client-ui-workspace": "workspace:*",
    "@kinetick-labs/kh-commands": "workspace:*",
    "@kinetick-labs/kh-compaction": "workspace:*",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-llm-retry": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-session-stats": "workspace:*",
    "@kinetick-labs/kh-session-turn-outline": "workspace:*",
    "@kinetick-labs/kh-subagent": "workspace:*",
    "@kinetick-labs/kh-token-meter": "workspace:*",
    "@kinetick-labs/kh-tools": "workspace:*",
    "@kinetick-labs/kh-util-workspace-path": "workspace:*",
    "@kinetick-labs/kh-util-values": "workspace:*",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@kinetick-labs/kh-settings": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
