{
  "name": "@kinetick-labs/kh-subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "kh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-subagent": "workspace:*",
    "@kinetick-labs/kh-subprocess": "workspace:*",
    "@kinetick-labs/kh-timeout": "workspace:*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@kinetick-labs/kh-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-app-boot": "workspace:*",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-loader-smoke": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-session-checkpoint-policy": "workspace:*",
    "@kinetick-labs/kh-session-persistence-jsonl": "workspace:*",
    "@kinetick-labs/kh-session-projection": "workspace:*",
    "@kinetick-labs/kh-subagent": "workspace:*",
    "@kinetick-labs/kh-subagent-codex": "workspace:*",
    "@kinetick-labs/kh-subprocess": "workspace:*",
    "@kinetick-labs/kh-subprocess-local": "workspace:*",
    "@kinetick-labs/kh-timeout": "workspace:*",
    "@kinetick-labs/kh-tool-jobs": "workspace:*",
    "@kinetick-labs/kh-tool-subagent": "workspace:*",
    "@kinetick-labs/kh-tools": "workspace:*"
  }
}
