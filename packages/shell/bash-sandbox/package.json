{
  "name": "@kinetick-labs/kh-bash-sandbox",
  "description": "Sandbox-consuming implementation of the KinetickHarness bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@kinetick-labs/kh-shell": "workspace:*",
    "@kinetick-labs/kh-bash-local": "workspace:*",
    "@kinetick-labs/kh-sandbox": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@kinetick-labs/kh-shell": "workspace:*",
    "@kinetick-labs/kh-bash-local": "workspace:*",
    "@kinetick-labs/kh-subprocess-local": "workspace:*",
    "@kinetick-labs/kh-sandbox": "workspace:*",
    "@kinetick-labs/kh-sandbox-local": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/node-addon-system": "workspace:~",
    "@kinetick-labs/kh-session-projection": "workspace:*"
  }
}
