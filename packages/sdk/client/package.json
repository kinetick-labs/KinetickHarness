{
  "name": "@kinetick-labs/kh-sdk-client",
  "description": "TypeScript client SDK for driving a KinetickHarness runtime subprocess over stdio JSON-RPC: the DeepSeekHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@kinetick-labs/kh": "workspace:*"
  },
  "peerDependencies": {
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-sdk-protocol": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-sdk-protocol": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
