  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-ssh": "workspace:*",
    "@kinetick-labs/kh-fs": "workspace:*",
    "@kinetick-labs/kh-sandbox": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-ssh": "workspace:*",
    "@kinetick-labs/kh-fs": "workspace:*",
    "@kinetick-labs/kh-sandbox": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*"
  }
