{
  "name": "@kinetick-labs/kh-plugin-manager",
  "description": "Current-profile plugin and bundle management shared by kh CLI, Web and agent tools",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@kinetick-labs/kh-app-boot": "workspace:*",
    "@kinetick-labs/kh-atomic-write": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "execa": "^10.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@kinetick-labs/kh-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@kinetick-labs/kh-host-plugin-inventory": "workspace:*",
    "@kinetick-labs/kh-subprocess": "workspace:*",
    "@kinetick-labs/kh-typert-protocol": "workspace:*",
    "@kinetick-labs/kh-tools": "workspace:*",
    "@kinetick-labs/kh-hmr": "workspace:*",
    "@kinetick-labs/kh-brand": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*",
    "@kinetick-labs/kh-sandbox": "workspace:*",
    "@kinetick-labs/kh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@kinetick-labs/kh-hmr": {
      "optional": true
    },
    "@kinetick-labs/kh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "@kinetick-labs/kh-package-manifest": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@kinetick-labs/kh-host-plugin-inventory": "workspace:*",
    "@kinetick-labs/kh-subprocess": "workspace:*",
    "@kinetick-labs/kh-typert-protocol": "workspace:*",
    "@kinetick-labs/kh-tools": "workspace:*",
    "@kinetick-labs/kh-system-prompt": "workspace:*",
    "@kinetick-labs/kh-hmr": "workspace:*",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@kinetick-labs/kh-brand": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*",
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-session-projection": "workspace:*",
    "@kinetick-labs/kh-sandbox": "workspace:*",
    "@kinetick-labs/kh-user-approval": "workspace:*"
  }
}
