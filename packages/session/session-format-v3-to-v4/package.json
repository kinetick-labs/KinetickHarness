{
  "name": "@kinetick-labs/kh-session-format-v3-to-v4",
  "description": "Streaming tool-role migration and delivery validation from Session V3 to V4",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/session/session-format-v3-to-v4"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "kh": {
    "sessionFormatMigration": {
      "from": 3,
      "to": 4,
      "export": ".",
      "migration": "sessionFormatV3ToV4",
      "sourceCodec": "releasedV3SessionFormatCodec",
      "targetCodec": "releasedV4SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV4Header",
      "targetRestorer": "restoreReleasedV4Artifact"
    }
  },
  "dependencies": {
    "@kinetick-labs/kh-session-format": "workspace:*",
    "@kinetick-labs/kh-session-format-v2-to-v3": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
