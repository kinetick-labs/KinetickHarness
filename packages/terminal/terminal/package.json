{
  "name": "@kinetick-labs/kh-terminal",
  "description": "Persistent PTY session seam for the KinetickHarness — owner-scoped ids, backend registry, interactive sends, reads, signals, and awaited cleanup",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/terminal/terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-brand": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-agent-loop-testkit": "workspace:*",
    "@kinetick-labs/kh-brand": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
