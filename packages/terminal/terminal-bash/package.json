{
  "name": "@kinetick-labs/kh-terminal-bash",
  "description": "Persistent shell PTY backend over the KinetickHarness subprocess terminal primitive",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-terminal": "workspace:*",
    "@kinetick-labs/kh-sandbox": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-subprocess": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-session-projection": "workspace:*"
  },
  "dependencies": {
    "@kinetick-labs/kh-lazy-require": "workspace:*",
    "@kinetick-labs/kh-pwsh-local": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-agent-loop-testkit": "workspace:*",
    "@kinetick-labs/kh-terminal": "workspace:*",
    "@kinetick-labs/kh-sandbox": "workspace:*",
    "@kinetick-labs/kh-sandbox-policy": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-subprocess": "workspace:*",
    "@kinetick-labs/kh-subprocess-local": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
