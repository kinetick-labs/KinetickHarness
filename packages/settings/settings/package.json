{
  "name": "@kinetick-labs/kh-settings",
  "description": "Abstract user-settings seam (ctx.settings) for the KinetickHarness",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-brand": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-brand": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@kinetick-labs/kh-app-boot": "workspace:*",
    "@kinetick-labs/kh-hmr": "workspace:*",
    "@kinetick-labs/kh-agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@kinetick-labs/kh-util-values": "workspace:*",
    "@kinetick-labs/kh-config-editor": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
