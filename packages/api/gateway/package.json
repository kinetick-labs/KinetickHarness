{
  "name": "@kinetick-labs/kh-api-gateway",
  "description": "Typert Remote Host dispatcher and Client API endpoint",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/api/gateway"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./stream-protocol": {
      "types": "./lib/types/stream-protocol.d.ts",
      "default": "./lib/types/stream-protocol.js"
    }
  },
  "kh": {
    "client": {
      "inject": [
        "@kinetick-labs/kh-typert-registry",
        "@kinetick-labs/kh-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@kinetick-labs/kh-deque": "workspace:*",
    "@kinetick-labs/kh-timeout": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "ws": "^8.21.0",
    "@kinetick-labs/kh-typert-protocol": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-client-connection": "workspace:*"
  },
  "devDependencies": {
    "@kinetick-labs/kh-brand": "workspace:*",
    "@kinetick-labs/kh-cmdline": "workspace:*",
    "@kinetick-labs/kh-client-connection": "workspace:*",
    "@kinetick-labs/kh-host-webserver": "workspace:*",
    "@kinetick-labs/kh-remote-mock": "workspace:*",
    "@kinetick-labs/kh-typert-registry": "workspace:*",
    "@kinetick-labs/kh-util-crypto": "workspace:*",
    "@types/ws": "^8.18.1",
    "@deepseek-ai/cordis": "workspace:~",
    "zod": "^4.4.3"
  }
}
