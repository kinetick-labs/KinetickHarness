{
  "name": "@kinetick-labs/kh-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "kh": {
    "client": {
      "inject": [
        "@kinetick-labs/kh-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@kinetick-labs/kh-deque": "workspace:*",
    "@kinetick-labs/kh-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-scope": "workspace:*"
  },
  "devDependencies": {
    "@kinetick-labs/kh-agent": "workspace:*",
    "@kinetick-labs/kh-agent-preset-registry": "workspace:*",
    "@kinetick-labs/kh-api-gateway": "workspace:*",
    "@kinetick-labs/kh-api-job-controller": "workspace:*",
    "@kinetick-labs/kh-api-session-controller": "workspace:*",
    "@kinetick-labs/kh-api-settings-controller": "workspace:*",
    "@kinetick-labs/kh-api-workspace-controller": "workspace:*",
    "@kinetick-labs/kh-api-workspace-files": "workspace:*",
    "@kinetick-labs/kh-client-connection": "workspace:*",
    "@kinetick-labs/kh-client-file-upload": "workspace:*",
    "@kinetick-labs/kh-commands": "workspace:*",
    "@kinetick-labs/kh-cordis-host-runner": "workspace:*",
    "@kinetick-labs/kh-credentials": "workspace:*",
    "@kinetick-labs/kh-file-reference": "workspace:*",
    "@kinetick-labs/kh-goal": "workspace:*",
    "@kinetick-labs/kh-host-plugin-inventory": "workspace:*",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-message-feedback": "workspace:*",
    "@kinetick-labs/kh-permission-presets": "workspace:*",
    "@kinetick-labs/kh-schedule": "workspace:*",
    "@kinetick-labs/kh-scope": "workspace:*",
    "@kinetick-labs/kh-session-reference": "workspace:*",
    "@kinetick-labs/kh-settings": "workspace:*",
    "@kinetick-labs/kh-subagent": "workspace:*",
    "@kinetick-labs/kh-typert-protocol": "workspace:*",
    "@kinetick-labs/kh-user-approval": "workspace:*",
    "@kinetick-labs/kh-user-questions": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "zod": "^4.4.3",
    "@kinetick-labs/kh-command-feedback": "workspace:*",
    "@kinetick-labs/kh-api-terminal-controller": "workspace:*",
    "@kinetick-labs/kh-plugin-manager": "workspace:*",
    "@kinetick-labs/kh-client-ui-plugin-manager": "workspace:*",
    "@kinetick-labs/kh-office-to-pdf": "workspace:*",
    "@kinetick-labs/kh-api-account-controller": "workspace:*",
    "@kinetick-labs/kh-deepseek-account": "workspace:*"
  }
}
