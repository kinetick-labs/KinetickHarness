    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-session-persistence": "workspace:*",
    "@kinetick-labs/kh-session-projection": "workspace:*",
    "@kinetick-labs/kh-session-projection-cache": "workspace:*",
    "@kinetick-labs/kh-session-query": "workspace:*",
    "@kinetick-labs/kh-session-title": "workspace:*",
    "@kinetick-labs/kh-settings": "workspace:*",
    "@kinetick-labs/kh-skill": "workspace:*",
