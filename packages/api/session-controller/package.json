    "@kinetick-labs/kh-client-file-upload": "workspace:*",
    "@kinetick-labs/kh-commands": "workspace:*",
    "@kinetick-labs/kh-credentials": "workspace:*",
    "@kinetick-labs/kh-file-reference": "workspace:*",
    "@kinetick-labs/kh-fs": "workspace:*",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-native-command": "workspace:*",
    "@kinetick-labs/kh-scope": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-session-persistence": "workspace:*",
    "@kinetick-labs/kh-session-projection": "workspace:*",
    "@kinetick-labs/kh-session-projection-cache": "workspace:*",
    "@kinetick-labs/kh-session-query": "workspace:*",
    "@kinetick-labs/kh-session-title": "workspace:*",
    "@kinetick-labs/kh-settings": "workspace:*",
    "@kinetick-labs/kh-skill": "workspace:*",
    "@kinetick-labs/kh-subagent": "workspace:*",
    "@kinetick-labs/kh-typert-protocol": "workspace:*",
    "@kinetick-labs/kh-typert-registry": "workspace:*",
    "@kinetick-labs/kh-util-time": "workspace:*",
    "@kinetick-labs/kh-util-values": "workspace:*",
    "@kinetick-labs/kh-util-workspace-path": "workspace:*",
    "@kinetick-labs/kh-workspace": "workspace:*"
  },
  "peerDependenciesMeta": {
