{
  "name": "@kinetick-labs/kh-agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the KinetickHarness",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-scope": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-session-projection": "workspace:*",
    "@kinetick-labs/kh-system-prompt": "workspace:*",
    "@kinetick-labs/kh-typert-protocol": "workspace:*",
    "@kinetick-labs/kh-util-values": "workspace:*",
    "@kinetick-labs/kh-workspace": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@kinetick-labs/kh-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-scope": "workspace:*",
    "@kinetick-labs/kh-session": "workspace:*",
    "@kinetick-labs/kh-session-projection": "workspace:*",
    "@kinetick-labs/kh-system-prompt": "workspace:*",
    "@kinetick-labs/kh-typert-protocol": "workspace:*",
    "@kinetick-labs/kh-typert-registry": "workspace:*",
    "@kinetick-labs/kh-util-values": "workspace:*",
    "@kinetick-labs/kh-workspace": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
