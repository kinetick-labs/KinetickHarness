{
  "name": "@kinetick-labs/kh-mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinetick-labs/KinetickHarness.git",
    "directory": "packages/mcp/mcp-client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@kinetick-labs/kh-attachment": "workspace:*",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-scope": "workspace:*",
    "@kinetick-labs/kh-subprocess": "workspace:*",
    "@kinetick-labs/kh-timeout": "workspace:*",
    "@kinetick-labs/kh-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-mcp-resources": "workspace:*",
    "@kinetick-labs/kh-system-prompt": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.0.0",
    "@kinetick-labs/kh-util-values": "workspace:*"
  },
  "devDependencies": {
    "@kinetick-labs/kh-attachment": "workspace:*",
    "@kinetick-labs/kh-attachment-local": "workspace:*",
    "@kinetick-labs/kh-llm": "workspace:*",
    "@kinetick-labs/kh-scope": "workspace:*",
    "@kinetick-labs/kh-subprocess": "workspace:*",
    "@kinetick-labs/kh-timeout": "workspace:*",
    "@kinetick-labs/kh-tools": "workspace:*",
    "@modelcontextprotocol/server-everything": "^2026.7.4",
    "@modelcontextprotocol/server-filesystem": "^2026.7.4",
    "@deepseek-ai/cordis": "workspace:~",
    "@kinetick-labs/kh-http-proxy": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "^4.4.3",
    "@kinetick-labs/kh-mcp-resources": "workspace:*",
    "@kinetick-labs/kh-system-prompt": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@kinetick-labs/kh-mcp-resources": {
      "optional": true
    },
    "@kinetick-labs/kh-system-prompt": {
      "optional": true
    }
  }
}
